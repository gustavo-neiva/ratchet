#!/usr/bin/env bash
# =============================================================================
#  ratchet — an unattended-but-safe agent loop.  (bash core, entrypoint)
# =============================================================================
#  Wraps a headless coding agent (pi, or any -p-style CLI via --agent-cmd) ONE
#  turn at a time: survives provider rate limits, gates every commit on a green
#  test suite, and routes shared-state actions (push, PR/MR) through a human.
#  A RED tree is never committed. The engine is task-agnostic; the repo's own
#  AGENTS.md + PLAN.md + .ratchet.conf carry all project knowledge.
#
#  See `ratchet --help`. Bash 3.2+ (no associative arrays, no `timeout` binary).
# =============================================================================
set -o pipefail

# locate this script's repo root so lib/ + templates/ resolve regardless of CWD
# AND regardless of being invoked through a symlink on PATH (the normal install).
# Resolve the symlink chain by hand — `readlink -f` is GNU-only (absent on macOS).
_src="${BASH_SOURCE[0]}"
while [ -h "$_src" ]; do
  _dir="$(cd -P "$(dirname "$_src")" && pwd)"
  _src="$(readlink "$_src")"
  case "$_src" in /*) ;; *) _src="$_dir/$_src";; esac   # relative link -> absolute
done
RATCHET_ROOT="$(cd -P "$(dirname "$_src")/.." && pwd)"
unset _src _dir
export RATCHET_ROOT

for _mod in common contract tracker classify model-fallback models \
            commit-gate session-sanitize observability run-turn commands render; do
  # shellcheck disable=SC1090
  . "$RATCHET_ROOT/lib/${_mod}.sh"
done
unset _mod

# ----------------------------- pre-scan (for conf precedence) ----------------
# Tolerantly extract just the subcommand + repo dir so we can locate + load the
# repo's .ratchet.conf (parsed) BEFORE the authoritative flag parse. parse_args
# (below) is the authority; this only finds command/dir and skips everything else.
NEW_IDEA=""
pre_scan() {
  COMMAND=""; REPO_DIR=""; NEW_IDEA=""
  while [ $# -gt 0 ]; do
    case "$1" in
      -d|--dir)         REPO_DIR="${2:-}"; shift 2;;
      --dir=*)          REPO_DIR="${1#*=}"; shift;;
      -p|--prompt|-s|--session|-m|--models|--thinking|--turn-timeout|--cooldown|\
      --both-wait|--step-token|--done-token|--verify-cmd|--agent-cmd|\
      --cache-retention|--tail|--heartbeat) shift 2;;
      init|new|plan|doctor|run|once|selftest|stats|watch|status|models)
        [ -z "$COMMAND" ] && COMMAND="$1"; shift;;
      -*) shift;;
      *)
        if [ "$COMMAND" = "new" ] && [ -z "$NEW_IDEA" ]; then NEW_IDEA="$1"
        elif [ -z "$REPO_DIR" ]; then REPO_DIR="$1"; fi
        shift;;
    esac
  done
  [ -n "$COMMAND" ] || COMMAND="run"
}

# ----------------------------- authoritative arg parser ----------------------
parse_args() {
  while [ $# -gt 0 ]; do
    case "$1" in
      -d|--dir)         REPO_DIR="${2:-}"; shift 2;;
      -p|--prompt)      PROMPT_OVERRIDE="${2:-}"; shift 2;;
      -s|--session)     SESSION_NAME="${2:-}"; shift 2;;
      -m|--models)      MODELS="${2:-}"; shift 2;;
      --agent-cmd)      AGENT_CMD="${2:-}"; shift 2;;
      --thinking)       THINKING="${2:-}"; shift 2;;
      --turn-timeout)   TURN_TIMEOUT="${2:-}"; shift 2;;
      --cooldown)       COOLDOWN="${2:-}"; shift 2;;
      --both-wait)      BOTH_WAIT="${2:-}"; shift 2;;
      --step-token)     STEP_TOKEN="${2:-}"; shift 2;;
      --done-token)     DONE_TOKEN="${2:-}"; shift 2;;
      --commit)         COMMIT_EACH_TURN=1; shift;;
      --no-commit)      COMMIT_EACH_TURN=0; shift;;
      --verify-cmd)     VERIFY_CMD="${2:-}"; shift 2;;
      --no-verify-gate) COMMIT_VERIFY_GATE=0; shift;;
      --push)           PUSH_ON_DONE=1; shift;;
      --pr)             OPEN_PR=1; PUSH_ON_DONE=1; shift;;
      --approve)        APPROVE_UI=1; shift;;
      --resume)         RESUME_SESSION=1; shift;;
      --no-resume)      RESUME_SESSION=0; shift;;
      --cache-retention) CACHE_RETENTION="${2:-}"; shift 2;;
      --no-sanitize)    SANITIZE_THINKING=0; shift;;
      --tail)           TAIL_LINES="${2:-}"; shift 2;;
      --heartbeat)      HEARTBEAT="${2:-}"; shift 2;;
      --stream)         STREAM_AGENT=1; shift;;
      --cheap)          CHEAP_MODE=1; shift;;
      --quiet)          QUIET=1; STREAM_AGENT=0; shift;;
      --once)           ONCE=1; shift;;
      --selftest)       SELFTEST=1; COMMAND="selftest"; shift;;
      --stats)          STATS=1; COMMAND="stats"; shift;;
      --watch)          WATCH=1; COMMAND="watch"; shift;;
      -v|--verbose)     VERBOSE=1; shift;;
      -h|--help)        usage; exit 0;;
      --) shift; break;;
      init|new|plan|doctor|run|once|selftest|stats|watch|status) COMMAND="$1"; shift;;
      -*) die "unknown option: $1 (see --help)";;
      *)
        if [ "$COMMAND" = "new" ] && [ -z "$PROMPT_OVERRIDE" ]; then
          PROMPT_OVERRIDE="$1"     # for `new`, the idea rides in the prompt slot
        elif [ -z "$REPO_DIR" ]; then REPO_DIR="$1"
        elif [ "$1" = "$REPO_DIR" ]; then :    # pre_scan already captured it; skip
        else die "unexpected argument: $1"; fi
        shift;;
    esac
  done
}

# ----------------------------- push / PR (after ALL_DONE) --------------------
# Human owns the merge; the loop only opens a reviewable PR. Opt-in (--push/--pr).
maybe_push_or_pr() {
  if { [ "$PUSH_ON_DONE" = 1 ] || [ "$OPEN_PR" = 1 ]; } && [ -d "$REPO_DIR/.git" ]; then
    emit "pushing (after $DONE_TOKEN) ..."
    if git push >>"$LOOP_LOG" 2>&1; then emit "pushed."; else emit "git push failed (see $LOOP_LOG) — branch left local."; return 1; fi
    if [ "$OPEN_PR" = 1 ]; then
      if command -v gh >/dev/null 2>&1 && git remote get-url origin >/dev/null 2>&1; then
        local body; body="$(tracker_completed_list | sed 's/^/- /')"
        emit "opening PR (gh) ..."
        if gh pr create --title "ratchet: $(tracker_completed_subject)" \
             --body "Autonomous loop completed all tracker tasks.

Completed:
$body" >>"$LOOP_LOG" 2>&1; then
          emit "PR opened — review & merge (the agent never merges)."
        else emit "gh pr create failed (see $LOOP_LOG)."; fi
      else
        emit "no gh / no origin remote — leaving the pushed branch for you to open a PR/MR."
      fi
    fi
  fi
}

# ----------------------------- main ------------------------------------------
main() {
  pre_scan "$@"

  # 1) global conf (sourced; trusted; NOT agent-writable) overrides defaults.
  if [ -f "$GLOBAL_CONF" ]; then
    # shellcheck disable=SC1090
    . "$GLOBAL_CONF"
  fi

  # 2) repo .ratchet.conf (PARSED, never sourced) overrides the global conf.
  if [ -n "$REPO_DIR" ] && [ -d "$REPO_DIR" ] && [ -f "$REPO_DIR/.ratchet.conf" ]; then
    if ! parse_repo_conf "$REPO_DIR/.ratchet.conf"; then
      # tolerate at run time, but surface it; doctor is the strict gate.
      emit "WARNING: $REPO_DIR/.ratchet.conf has issues (run 'ratchet doctor'):" >&2
      printf '%b\n' "$RATCHET_CONF_ERRORS" >&2
    fi
  fi

  # 2.5) `ratchet models` is config tooling, not a loop run — it parses its
  # own args (model ids, --tier/--pos) which parse_args would reject. Runs
  # after the conf load so `list` shows the effective chains.
  if [ "$COMMAND" = "models" ]; then
    _margs=(); _mseen=0
    for _a in "$@"; do
      if [ "$_mseen" = 0 ] && [ "$_a" = "models" ]; then _mseen=1; continue; fi
      _margs+=("$_a")
    done
    cmd_models "${_margs[@]+"${_margs[@]}"}"; exit $?
  fi

  # 3) CLI flags win (authoritative parse).
  parse_args "$@"

  # fast exits
  case "$COMMAND" in
    selftest) exec "$RATCHET_ROOT/test/selftest.sh" ;;
    -h|help) usage; exit 0 ;;
  esac

  # token economy: export the cache TTL so the stable prefix stays cached.
  [ -n "$CACHE_RETENTION" ] && export PI_CACHE_RETENTION="$CACHE_RETENTION"

  # resolve repo dir
  [ -n "$REPO_DIR" ] || REPO_DIR="$PWD"
  REPO_DIR="$(cd "$REPO_DIR" 2>/dev/null && pwd)" || die "repo dir not found: $REPO_DIR"

  # session id + slug + logs (logs live OUT of the repo, under RATCHET_HOME).
  local slug; slug=$(project_slug "$REPO_DIR")
  if [ -n "$SESSION_NAME" ]; then SESSION_ID="ratchet-${SESSION_NAME}"; else SESSION_ID="ratchet-${slug}"; fi
  LOG_DIR="$RATCHET_HOME/logs/$slug"; mkdir -p "$LOG_DIR"
  LOOP_LOG="$LOG_DIR/loop.log"
  TURN_OUT="$LOG_DIR/last_turn.out"

  case "$COMMAND" in
    init)    cmd_init "$REPO_DIR"; exit $? ;;
    new)     cmd_new "${PROMPT_OVERRIDE:-$NEW_IDEA}" "$REPO_DIR"; exit $? ;;
    plan)    cmd_plan "$REPO_DIR"; exit $? ;;
    doctor)  cmd_doctor "$REPO_DIR" 0; exit $? ;;
    stats)   init_models "$MODELS"; cmd_stats; exit $? ;;
    watch)   init_models "$MODELS"; watch_session; exit $? ;;
    status)  cmd_status; exit $? ;;
  esac

  # run / once: doctor preflight first (fail before the first turn, not turn 3).
  emit "preflight (doctor) ..."
  if ! cmd_doctor "$REPO_DIR" 0 >/dev/null 2>&1; then
    emit "preflight FAILED — run 'ratchet doctor $REPO_DIR' for details. Aborting before any turn."
    cmd_doctor "$REPO_DIR" 0
    exit 1
  fi

  # finalize tracker (auto-detect if conf left it empty)
  TRACKER_FILE="${TRACKER_FILE:-$(detect_tracker_file "$REPO_DIR")}"
  [ -n "$TRACKER_FILE" ] || TRACKER_FILE="PLAN.md"

  [ "$COMMAND" = "once" ] && ONCE=1

  PROMPT="${PROMPT_OVERRIDE:-$(build_default_prompt)}"
  
  # Initialize models: if MODELS is empty but tier keys are set, defer init to first turn.
  # Otherwise, init with MODELS and validate it's non-empty.
  if [ -z "$MODELS" ] && { [ -n "$PLAN_MODELS" ] || [ -n "$BUILD_MODELS" ] || [ -n "$LIGHT_MODELS" ]; }; then
    # Tier keys are set; init will happen per-turn. Pick a default for the startup message.
    models_arr=("<tier-routing>")
  else
    init_models "$MODELS"
    [ -n "$MODELS" ] || die "no models configured (-m chain, MODELS in .ratchet.conf, or global conf)."
  fi

  [ -d "$REPO_DIR/.git" ] || emit "warning: '$REPO_DIR' is not a git repo (continuing)"

  emit "============================================================"
  emit "ratchet START"
  emit "  repo      : $REPO_DIR"
  emit "  session   : $SESSION_ID (resume=$([ "$RESUME_SESSION" = 1 ] && echo yes || echo no))"
  emit "  tracker   : $TRACKER_FILE"
  emit "  models    : ${models_arr[*]}  (preference order, fallback chain)"
  emit "  turn cap  : ${TURN_TIMEOUT}s   cooldown: ${COOLDOWN}s   both-wait: ${BOTH_WAIT}s"
  emit "  tokens    : step='${STEP_TOKEN}'  done='${DONE_TOKEN}'"
  emit "  agent     : $AGENT_CMD"
  emit "  thinking  : ${THINKING:-inherit}"
  [ "$CHEAP_MODE" = 1 ] && emit "  cheap     : ALL tiers → $(chain_for_tier light)"
  emit "  verify    : ${VERIFY_CMD:-<EMPTY — loud warning, no gate>}"
  emit "  commit    : per-turn=$([ "$COMMIT_EACH_TURN" = 1 ] && echo yes || echo no)  push-on-done=$([ "$PUSH_ON_DONE" = 1 ] && echo yes || echo no)  pr=$([ "$OPEN_PR" = 1 ] && echo yes || echo no)"
  emit "  loop log  : $LOOP_LOG"
  emit "  stop      : Ctrl-C"
  emit "============================================================"

  cd "$REPO_DIR" || die "cannot cd into $REPO_DIR"

  # Write PID file (for `ratchet status` to check if the loop is alive)
  echo $$ > "$LOG_DIR/loop.pid"

  # leftover staged changes (e.g. a previous run killed mid-gate) ride the next
  # green-gated commit — safe, but never silent.
  if [ -d .git ] && ! git diff --cached --quiet 2>/dev/null; then
    emit "WARNING: staged changes detected at startup (previous killed run?) — they will ride the next green-gated commit."
  fi

  local turn=0 current_tier="" current_tier_chain="" done_gate_fails=0
  while true; do
    turn=$((turn+1))
    
    # Tier routing: determine tier from tracker tag, reinit models only on tier change.
    local tag tier tier_chain tier_thinking
    tag=$(tracker_next_tag)
    case "$tag" in
      trivial) tier="light" ;;
      hard)    tier="build-hard" ;;  # bumps thinking unless THINKING_BUILD is set
      *)       tier="build" ;;
    esac
    [ "$CHEAP_MODE" = 1 ] && tier="light"   # --cheap: every task on the light chain
    tier_chain=$(chain_for_tier "${tier%-hard}")  # strip -hard suffix for chain lookup
    
    # Reinit models ONLY when tier changes (preserve bench/cooldown state within a tier).
    if [ "$tier_chain" != "$current_tier_chain" ]; then
      init_models "$tier_chain"
      current_tier="$tier"
      current_tier_chain="$tier_chain"
    fi
    
    local idx; idx=$(pick_model_index)
    if [ "$idx" = "-1" ]; then
      # Tier chain exhausted: fall back to global MODELS for one turn before sleeping.
      if [ "$current_tier_chain" != "$MODELS" ]; then
        emit "tier ($tier) chain exhausted — falling back to MODELS for this turn."
        init_models "$MODELS"
        current_tier_chain="$MODELS"
        idx=$(pick_model_index)
      fi
      # If still -1, ALL models are benched.
      if [ "$idx" = "-1" ]; then
        emit "ALL models benched (exhausted). Sleeping ${BOTH_WAIT}s, then reset + retry."
        sleep "$BOTH_WAIT"
        reset_all
        current_tier=""
        current_tier_chain=""
        continue
      fi
    fi
    
    local model="${models_arr[$idx]}"
    tier_thinking=$(thinking_for_tier "$tier")
    THINKING="$tier_thinking"  # set global THINKING for run_turn

    # progress: done/total + the task this turn will work on (additive UX line)
    local done_n open_n total_n next_line next_task
    done_n=$(tracker_count_done)
    open_n=$(grep -cE '^[[:space:]]*-?[[:space:]]*\[( |IN PROGRESS)\]' "$REPO_DIR/$TRACKER_FILE" 2>/dev/null)
    total_n=$(( done_n + ${open_n:-0} ))
    next_line=$(tracker_next inprogress); [ -z "$next_line" ] && next_line=$(tracker_next open)
    next_task=$(printf '%s' "$next_line" | sed -E 's/^[0-9]+://; s/^[[:space:]]*-?[[:space:]]*\[[^]]*\][[:space:]]*//')
    emit "tasks: ${done_n} done / ${total_n} total | next: $(printf '%.60s' "${next_task:-—}")"
    
    # Terminal-only PM status block (loop.log stays machine-readable)
    local minfo mname mindex mcount mdone mtotal task_info taskid tasktext
    minfo=$(tracker_current_milestone)
    if [ -n "$minfo" ]; then
      mname=$(printf '%s' "$minfo" | cut -f1)
      mdone=$(printf '%s' "$minfo" | cut -f4)
      mtotal=$(printf '%s' "$minfo" | cut -f5)
    else
      mname=""; mdone=0; mtotal=0
    fi
    task_info=$(tracker_next_id_and_text)
    taskid=$(printf '%s' "$task_info" | sed -E 's/ \([^)]*\) .*//')
    tasktext=$(printf '%s' "$task_info" | sed -E 's/^[^ ]* \([^)]*\) //')
    term_only "$(render_status_block "$done_n" "$total_n" "$mname" "$mdone" "$mtotal" "$turn" "$tier" "$model" "$taskid" "$tasktext")"

    # inject the already-known current task into the prompt: saves the agent
    # 1-3 discovery round-trips per ephemeral turn (the tracker stays authoritative).
    if [ -z "$PROMPT_OVERRIDE" ]; then
      PROMPT="$(build_default_prompt)"
      [ -n "$next_task" ] && PROMPT="$PROMPT
The current tracker task is: $next_task
(Verify it is still the first open/IN PROGRESS task in $TRACKER_FILE before starting.)"
    fi

    emit "--- turn $turn | model=$model ---"
    emit "turn $turn | tier=$tier | model=$model | thinking=$tier_thinking | task=$(tracker_next_id_and_text)"

    local turn_start=$SECONDS
    run_turn "$model" "$tag"
    local turn_elapsed=$((SECONDS-turn_start))
    emit "turn $turn end | class=$TURN_STATUS | took=${turn_elapsed}s | task=$(printf '%.20s' "${next_task:-?}")"
    
    # Terminal-only timing line with ETA (loop.log has the frozen took= line above)
    local avg_secs; avg_secs=$(avg_turn_secs "$LOOP_LOG")
    term_only "$(render_timing "$turn" "$turn_elapsed" "$avg_secs" "$open_n")"
    
    show_excerpt

    case "$TURN_STATUS" in
      done)
        if ! commit_turn "$turn" "$model"; then
          done_gate_fails=$((done_gate_fails+1))
          emit "DONE turn was RED at commit gate — treating as repair-needed, not complete (${done_gate_fails}/${MAX_DONE_GATE_FAILS})."
          [ "$ONCE" = 1 ] && { emit "--once: stopping."; break; }
          # The agent already thinks all work is done, so it cannot self-repair a
          # gate it structurally can't pass (e.g. a secret-scan false positive).
          # Stop after a bound instead of spinning forever; hand off to a human.
          if [ "$done_gate_fails" -ge "$MAX_DONE_GATE_FAILS" ]; then
            emit "ALL_DONE but commit gate stayed RED for $MAX_DONE_GATE_FAILS turns — STOPPING for human review (see $LOOP_LOG)."
            break
          fi
          sleep "$SHORT_SLEEP"; continue
        fi
        done_gate_fails=0
        emit "agent signaled $DONE_TOKEN — all work complete."
        emit "final model used: $model"
        maybe_push_or_pr
        break ;;
      step)
        transient_arr[$idx]=0
        if ! commit_turn "$turn" "$model"; then
          emit "step turn RED at commit gate — next turn will repair. Sleeping ${SHORT_SLEEP}s."
          [ "$ONCE" = 1 ] && { emit "--once: stopping."; break; }
          sleep "$SHORT_SLEEP"; continue
        fi
        emit "step complete ($STEP_TOKEN). Sleeping ${SHORT_SLEEP}s."
        [ "$ONCE" = 1 ] && { emit "--once: stopping after one step."; break; }
        sleep "$SHORT_SLEEP" ;;
      exhausted)
        emit "model $model EXHAUSTED (quota/rate-limit). Benching ${COOLDOWN}s; switching."
        bench_model "$idx"
        [ "$ONCE" = 1 ] && { emit "--once: stopping."; break; }
        sleep "$SHORT_SLEEP" ;;
      hard)
        bump_transient "$idx"
        emit "model $model HARD ERROR (auth/not-found/bad-request). strike ${transient_arr[$idx]}/${MAX_TRANSIENT}. See $TURN_OUT"
        [ "${transient_arr[$idx]}" -ge "$MAX_TRANSIENT" ] && { emit "benching $model after $MAX_TRANSIENT hard errors — likely a config issue."; bench_model "$idx"; }
        [ "$ONCE" = 1 ] && { emit "--once: stopping."; break; }
        sleep "$SHORT_SLEEP" ;;
      timeout)
        bump_transient "$idx"
        local n=${transient_arr[$idx]} backoff=$(( SHORT_SLEEP * n ))
        emit "model $model TIMEOUT (deadline-${TURN_TIMEOUT}s, no token/error). strike ${n}/${MAX_TRANSIENT}; backing off ${backoff}s."
        [ "$n" -ge "$MAX_TRANSIENT" ] && { emit "benching $model after $MAX_TRANSIENT timeouts."; bench_model "$idx"; }
        [ "$ONCE" = 1 ] && { emit "--once: stopping."; break; }
        sleep "$backoff" ;;
      transient)
        bump_transient "$idx"
        local n=${transient_arr[$idx]} backoff=$(( SHORT_SLEEP * n ))
        emit "model $model transient failure. strike ${n}/${MAX_TRANSIENT}; backing off ${backoff}s."
        [ "$n" -ge "$MAX_TRANSIENT" ] && { emit "benching $model after $MAX_TRANSIENT transient failures."; bench_model "$idx"; }
        [ "$ONCE" = 1 ] && { emit "--once: stopping."; break; }
        sleep "$backoff" ;;
    esac
  done

  emit "ratchet END after $turn turn(s)."
}

# ponytail: exit on the SAME parsed line as main so bash never streams another
# byte after main returns — a self-edit mid-run (turns 6/10 rewrote this file)
# shifts byte offsets and bash would execute a stray fragment as top-level code.
main "$@"; exit $?
