# .ratchet.conf — the machine contract for this repo.
# PARSED (key=value, allowlisted keys only). NEVER sourced, NEVER executed.
# Only the keys below are recognized; unknown keys are a `ratchet doctor` error.
# The agent is FORBIDDEN from editing this file (the loop rejects any turn that
# touches it). Edit it yourself; it is human-owned.

RATCHET_PROTOCOL=1

# The work tracker. Auto-detected (PLAN.md > TODO.md > TASKS.md) if unset.
TRACKER_FILE=PLAN.md

# The green gate, run from the repo root before EVERY commit. A RED tree is
# never committed. EMPTY = commit with no gate (LOUD red warning each run; set
# this — no-gate is not safe-by-default).
VERIFY_CMD=npm test

# Data governance: which model providers may see this repo's code. Comma list of
# provider prefixes (e.g. zai,anthropic). Unset = the full global chain.
#ALLOWED_PROVIDERS=

# Model fallback chain for THIS repo (overrides the global default).
# Comma-separated, provider/id form, cheapest first.
#MODELS=zai/glm,anthropic/claude

# Per-step / all-done tokens the agent prints (keep in sync with AGENTS.md).
STEP_TOKEN=STEP_COMPLETE
DONE_TOKEN=ALL_DONE

# Paths to un-stage before each commit (runtime junk specific to this repo).
#COMMIT_EXCLUDE_GLOBS=

# Reasoning level each turn: off|minimal|low|medium|high|xhigh (empty = inherit).
#THINKING=medium

# Tiered model routing (v1.1): override MODELS for plan/build/light/review turns.
# Unset tier → falls back to MODELS. Tier exhausted → MODELS before sleep.
#PLAN_MODELS=anthropic/claude-fable-5,anthropic/claude-opus-4-8
#BUILD_MODELS=anthropic/claude-sonnet-4-5,zai/glm-5.2
#LIGHT_MODELS=zai/glm-5-turbo,zai/glm-4.5-air
#REVIEW_MODELS=anthropic/claude-sonnet-4-5
#THINKING_PLAN=
#THINKING_BUILD=
#THINKING_LIGHT=off
#THINKING_REVIEW=

# Price-ordered model ranking for derived chains (used when tier-specific MODELS unset).
# Fallback: auto-derived from models.dev catalog join. Snapshot on first use.
#MODEL_RANK=anthropic/claude-opus-4-8,anthropic/claude-sonnet-4-5,zai/glm-5.2

# PR flow (autonomous mode with human merge gates). Default: done (today's behavior).
#PR_CADENCE=done
# milestone → plan PR #0, review turn per milestone, PR per milestone, merge-gate.
#PR_CADENCE=milestone

# Review turn: max fail→fix cycles before human escalation. Default: 2.
#MAX_REVIEW_CYCLES=2

# Merge poll interval (secs). Default: 300 (5min).
#MERGE_POLL_SECS=300

# Merge wait timeout (secs). Default: 259200 (72h). After timeout, loop stops with notification.
#MERGE_WAIT_TIMEOUT=259200

# PR size soft warning threshold (changed lines). Default: 400. Warning only, never blocks.
#PR_SOFT_MAX_LINES=400

# Tunables (uncomment to override defaults):
#TURN_TIMEOUT=1800
# Kill a turn whose (streaming) output stops growing this long — hung-request
# defense far cheaper than waiting out TURN_TIMEOUT. Buffered agents unaffected.
#STALL_TIMEOUT=300
#COOLDOWN=14400
#HEARTBEAT=15
